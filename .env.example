# --- Auth ---
# IMPORTANT: bcrypt hashes contain literal "$" characters, and Next.js does
# shell-style $VAR expansion on .env files — storing the hash raw silently
# corrupts it. Store it base64-encoded instead:
#
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1], 10)).toString('base64'))" 'your-password'
#
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_B64=

# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Session lifetime in seconds (default 8 hours)
SESSION_TTL_SECONDS=28800

# --- Nginx control ---
# Path to the directory listing enabled sites (Debian/Ubuntu default shown).
# Leave blank to disable the "sites" panel.
NGINX_SITES_ENABLED_DIR=/etc/nginx/sites-enabled

# The systemctl unit name for nginx
NGINX_SERVICE_NAME=nginx

# --- PM2 ---
# Optional: restrict which pm2 process names/ids this dashboard is allowed to
# control. Comma separated. Leave blank to allow all processes owned by the
# user running this app.
PM2_ALLOWED_APPS=
